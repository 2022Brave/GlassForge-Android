<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="15dp" android:gravity="center_vertical"
    android:background="#D9172030">
    <TextView android:id="@+id/widget_accent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOW PLAYING" android:textColor="#FF9C5CFF" android:textSize="10sp" android:letterSpacing="0.15"/>
    <TextView android:id="@+id/music_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="No active track" android:textColor="#FFFFFFFF" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/music_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap title to enable media access" android:textColor="#BFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/music_previous" android:layout_width="52dp" android:layout_height="42dp" android:gravity="center" android:text="|◀" android:textColor="#FFFFFFFF" android:textSize="18sp" android:background="#22FFFFFF"/>
        <TextView android:id="@+id/music_play_pause" android:layout_width="64dp" android:layout_height="42dp" android:layout_marginHorizontal="10dp" android:gravity="center" android:text="▶" android:textColor="#FFFFFFFF" android:textSize="20sp" android:background="#339C5CFF"/>
        <TextView android:id="@+id/music_next" android:layout_width="52dp" android:layout_height="42dp" android:gravity="center" android:text="▶|" android:textColor="#FFFFFFFF" android:textSize="18sp" android:background="#22FFFFFF"/>
    </LinearLayout>
</LinearLayout>